// Prisma schéma pro Tipovačku.
// Po každé změně tohoto souboru spusť: npm run db:migrate

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Connection URL je v Prisma 7 v prisma.config.ts (pro migrace)
  // a v src/lib/db.ts předáván do PrismaPg adaptéru (pro runtime).
}

// =============================================================================
// Enums
// =============================================================================

/// Fáze turnaje. MS 2026 má 48 týmů, 12 skupin po 4, postupuje top 2 + 8 nejlepších 3.
enum Stage {
  GROUP
  ROUND_OF_32
  ROUND_OF_16
  QUARTER_FINAL
  SEMI_FINAL
  THIRD_PLACE
  FINAL
}

/// 12 skupin MS 2026 (A–L).
enum GroupName {
  A
  B
  C
  D
  E
  F
  G
  H
  I
  J
  K
  L
}

// =============================================================================
// Modely
// =============================================================================

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  /// Zobrazované jméno. Auth.js po prvním sign-inu necháva null —
  /// uživatel vyplní v /profil před zadáním tipů.
  name          String?
  /// Auth.js: datum, kdy uživatel kliknul na magic link a ověřil email.
  emailVerified DateTime?
  /// Auth.js: URL obrázku (pro budoucí OAuth providery). U email loginu null.
  image         String?
  isAdmin       Boolean      @default(false)
  createdAt     DateTime     @default(now())
  accounts      Account[]
  sessions      Session[]
  tips          Tip[]
  specialTips   SpecialTip[]
  groupRankings GroupRankingTip[]
}

// =============================================================================
// Auth.js (NextAuth v5) — tabulky vyžadované @auth/prisma-adapter
// =============================================================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Team {
  id          String     @id @default(cuid())
  /// Český název týmu, např. "Česko".
  name        String     @unique
  /// ISO 3-letter kód, např. "CZE".
  code        String     @unique
  /// Vlajka jako emoji, např. "🇨🇿".
  flagEmoji   String?
  /// Skupina A–L. Null, pokud ještě nepřiřazen (před losováním).
  group       GroupName?
  homeMatches Match[]    @relation("HomeTeam")
  awayMatches Match[]    @relation("AwayTeam")
}

model Match {
  id                 String     @id @default(cuid())
  /// Lidsky čitelný klíč zápasu, např. "M1" nebo "R16-3".
  matchKey           String     @unique
  stage              Stage
  /// Vyplněno jen pro stage = GROUP.
  group              GroupName?
  /// Datum a čas výkopu v UTC.
  dateUtc            DateTime
  homeTeamId         String?
  awayTeamId         String?
  homeTeam           Team?      @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam           Team?      @relation("AwayTeam", fields: [awayTeamId], references: [id])
  /// Skutečný výsledek (null, dokud se zápas nehraje).
  homeScore          Int?
  awayScore          Int?
  /// Pro vyřazovací zápasy s prodloužením/penaltami — true pokud domácí vyhráli na penalty.
  homeWonOnPenalties Boolean?
  tips               Tip[]

  @@index([dateUtc])
}

model Tip {
  id                  String   @id @default(cuid())
  userId              String
  matchId             String
  homeScore           Int
  awayScore           Int
  /// Jen pro vyřazovací zápasy — tip na vítěze v případě remízy.
  homeWinsOnPenalties Boolean?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  match               Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([userId, matchId])
  @@index([matchId])
}

/// Tip uživatele na konečné pořadí ve skupině (1.–4. místo).
/// `teamCodes` je seřazené pole 4 unikátních team.code, ze stejné skupiny.
model GroupRankingTip {
  id        String    @id @default(cuid())
  userId    String
  group     GroupName
  teamCodes String[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, group])
}

model SpecialTip {
  id        String   @id @default(cuid())
  userId    String
  /// Typ tipu, např. "TOURNAMENT_WINNER", "TOP_SCORER", "TOP_SCORER_GROUP_A".
  type      String
  /// Hodnota — kód týmu (např. "CZE") nebo jméno hráče.
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
}
