// Prisma schéma pro Tipovačku.
// Po každé změně tohoto souboru spusť: npm run db:migrate

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Connection URL je v Prisma 7 v prisma.config.ts (pro migrace)
  // a v src/lib/db.ts předáván do PrismaPg adaptéru (pro runtime).
}

// =============================================================================
// Enums
// =============================================================================

/// Fáze turnaje. MS 2026 má 48 týmů, 12 skupin po 4, postupuje top 2 + 8 nejlepších 3.
enum Stage {
  GROUP
  ROUND_OF_32
  ROUND_OF_16
  QUARTER_FINAL
  SEMI_FINAL
  THIRD_PLACE
  FINAL
}

/// 12 skupin MS 2026 (A–L).
enum GroupName {
  A
  B
  C
  D
  E
  F
  G
  H
  I
  J
  K
  L
}

// =============================================================================
// Modely
// =============================================================================

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  /// Zobrazované jméno. Auth.js po prvním sign-inu necháva null —
  /// uživatel vyplní v /profil před zadáním tipů.
  name          String?
  /// Auth.js: datum, kdy uživatel kliknul na magic link a ověřil email.
  emailVerified DateTime?
  /// Auth.js: URL obrázku (pro budoucí OAuth providery). U email loginu null.
  image         String?
  isAdmin             Boolean      @default(false)
  /// Zaplatil vstupní poplatek? Admin přepíná ručně v /admin/kontrola.
  paid                Boolean      @default(false)
  createdAt           DateTime     @default(now())
  accounts            Account[]
  sessions            Session[]
  tips                Tip[]
  specialTips         SpecialTip[]
  groupRankings       GroupRankingTip[]
  knockoutAdvancers   KnockoutAdvancersTip[]
  tipChangeLogs       TipChangeLog[]
  tipEditGrants       TipEditGrant[]
}

// =============================================================================
// Auth.js (NextAuth v5) — tabulky vyžadované @auth/prisma-adapter
// =============================================================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Team {
  id          String     @id @default(cuid())
  /// Český název týmu, např. "Česko".
  name        String     @unique
  /// ISO 3-letter kód, např. "CZE".
  code        String     @unique
  /// Vlajka jako emoji, např. "🇨🇿".
  flagEmoji   String?
  /// Skupina A–L. Null, pokud ještě nepřiřazen (před losováním).
  group       GroupName?
  homeMatches Match[]    @relation("HomeTeam")
  awayMatches Match[]    @relation("AwayTeam")
}

model Match {
  id                 String     @id @default(cuid())
  /// Lidsky čitelný klíč zápasu, např. "M1" nebo "R16-3".
  matchKey           String     @unique
  stage              Stage
  /// Vyplněno jen pro stage = GROUP.
  group              GroupName?
  /// Datum a čas výkopu v UTC.
  dateUtc            DateTime
  homeTeamId         String?
  awayTeamId         String?
  homeTeam           Team?      @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam           Team?      @relation("AwayTeam", fields: [awayTeamId], references: [id])
  /// Skutečný výsledek (null, dokud se zápas nehraje).
  homeScore          Int?
  awayScore          Int?
  /// Pro vyřazovací zápasy s prodloužením/penaltami — true pokud domácí vyhráli na penalty.
  homeWonOnPenalties Boolean?
  tips               Tip[]

  @@index([dateUtc])
}

model Tip {
  id                  String   @id @default(cuid())
  userId              String
  matchId             String
  homeScore           Int
  awayScore           Int
  /// Jen pro vyřazovací zápasy — tip na vítěze v případě remízy.
  homeWinsOnPenalties Boolean?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  match               Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([userId, matchId])
  @@index([matchId])
}

/// Tip uživatele na konečné pořadí ve skupině (1.–4. místo).
/// `teamCodes` je seřazené pole 4 unikátních team.code, ze stejné skupiny.
model GroupRankingTip {
  id        String    @id @default(cuid())
  userId    String
  group     GroupName
  teamCodes String[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, group])
}

/// Tip uživatele na týmy postupující do dané vyřazovací fáze.
/// stage je jen R32 / R16 / QF / SF / F (ne GROUP, ne THIRD_PLACE).
/// `teamCodes` je pole team.code (volně, neomezujeme délku schématem;
/// validace cílového počtu probíhá v UI/action).
model KnockoutAdvancersTip {
  id        String   @id @default(cuid())
  userId    String
  stage     Stage
  teamCodes String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, stage])
}

// =============================================================================
// Skutečné výsledky (zadává admin) — analogie tipů, ale jedna canonická verze
// =============================================================================

/// Skutečné pořadí ve skupině (1.–4. místo).
model GroupRankingResult {
  group     GroupName @id
  teamCodes String[]
  updatedAt DateTime  @updatedAt
}

/// Skutečné týmy, které postoupily do daného vyřazovacího kola.
model KnockoutAdvancersResult {
  stage     Stage    @id
  teamCodes String[]
  updatedAt DateTime @updatedAt
}

/// Skutečný vítěz turnaje, král střelců turnaje, králové střelců skupin.
/// type používá stejné konvence jako SpecialTip:
/// "TOURNAMENT_WINNER", "TOP_SCORER_TOURNAMENT", "TOP_SCORER_GROUP_<A-L>".
/// `acceptedAliases` — pro free-text typy (TOP_SCORER_*) seznam alternativních
/// jmen, která admin po turnaji ručně označil jako shodu s `value`.
/// Bodování porovnává normalizovaný tip vůči normalizovanému `value` i aliasům.
model TournamentResult {
  type            String   @id
  value           String
  acceptedAliases String[] @default([])
  updatedAt       DateTime @updatedAt
}

model SpecialTip {
  id        String   @id @default(cuid())
  userId    String
  /// Typ tipu, např. "TOURNAMENT_WINNER", "TOP_SCORER", "TOP_SCORER_GROUP_A".
  type      String
  /// Hodnota — kód týmu (např. "CZE") nebo jméno hráče.
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
}

// =============================================================================
// Audit log tipů
// =============================================================================

/// Append-only historie změn tipů pro řešení sporů.
/// Zapisuje se pouze při skutečné změně (oldValue != newValue).
///
/// `entityType`:
///   MATCH_TIP            — entityKey = match.id           (Tip model)
///   GROUP_RANKING        — entityKey = "A".."L"           (GroupRankingTip)
///   KNOCKOUT_ADVANCERS   — entityKey = stage string       (KnockoutAdvancersTip)
///   SPECIAL_TIP          — entityKey = SpecialTip.type    (např. "TOURNAMENT_WINNER")
///
/// `oldValue` / `newValue` — JSON snapshot tipu. null v `oldValue` = první vytvoření.
/// null v `newValue` = smazání tipu (např. prázdný free-text king-scorer).
model TipChangeLog {
  id          String   @id @default(cuid())
  userId      String
  entityType  String
  entityKey   String
  oldValue    Json?
  newValue    Json?
  changedAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, changedAt])
  @@index([entityType, entityKey])
}

// =============================================================================
// Ruční uzávěrky (přebití automatiky)
// =============================================================================

/// Ruční přebití automatické uzávěrky tipů. Pokud řádek pro daný `scope`
/// existuje, platí jeho `deadline` MÍSTO automatiky (výkop prvního zápasu
/// fáze / globální deadline). Když řádek chybí, platí automatika.
///
/// `scope`:
///   "STAGE:<Stage>"     — celé kolo (skupiny nebo jedno vyřazovací kolo)
///   "MATCH:<Match.id>"  — jednotlivý zápas (přebíjí i uzávěrku kola)
///   "GROUP_RANKINGS"    — tipy na pořadí skupin
///   "SPECIALS"          — speciální tipy (postupující, vítěz, král střelců)
///
/// `mode` (jen pro STAGE scope):
///   "FIXED"   — celé kolo se uzavře v jeden termín (`deadline`, nebo automatika).
///   "KICKOFF" — každý zápas kola se uzavře (a u skupin i odhalí) svým výkopem;
///               `deadline` se ignoruje (null).
///
/// Priorita při rozhodnutí, jestli je zápas uzamčený:
///   MATCH override > STAGE (FIXED deadline / KICKOFF výkop) > automatika.
model DeadlineOverride {
  scope     String    @id
  mode      String    @default("FIXED")
  deadline  DateTime?
  updatedAt DateTime  @updatedAt
}

// =============================================================================
// Dotipování přes speciální odkaz
// =============================================================================

/// Admin vystaví jednorázové povolení, aby konkrétní uživatel mohl i po
/// uzávěrce dotipovat vybrané vyřazovací zápasy. Odkaz `/dotipovani/<token>`
/// nevyžaduje přihlášení — token sám autorizuje zápis (vědomý kompromis pro
/// uzavřenou skupinu kamarádů, viz security_warnings.md). Platí do `expiresAt`
/// a admin ho může kdykoli smazat (zrušit).
model TipEditGrant {
  id              String    @id @default(cuid())
  /// Náhodný nehádatelný token v URL.
  token           String    @unique
  /// Komu je povolení vystaveno.
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Match.id zápasů, které uživatel smí přes odkaz vyplnit.
  matchIds        String[]
  /// Do kdy odkaz platí (UTC).
  expiresAt       DateTime
  /// Kdy uživatel odkaz naposledy použil (null = zatím nepoužil).
  usedAt          DateTime?
  /// Admin, který odkaz vystavil (User.id).
  createdByUserId String
  createdAt       DateTime  @default(now())

  @@index([userId])
}
